#====================================================================
# .env.example — template untuk DIX Game Farm
# Copy file ini jadi .env, lalu isi semua field sesuai environment lu.
# Untuk setup email Gmail SMTP, baca tutorialemail.md (kalau ada).
#====================================================================

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'http://localhost:8080/'
app.indexPage = ''
app.forceGlobalSecureRequests = false
app.CSPEnabled = false

#--------------------------------------------------------------------
# DATABASE (XAMPP MySQL default: user=root, password=kosong)
#--------------------------------------------------------------------

database.default.hostname = localhost
database.default.database = dixgamefarm_db
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

#--------------------------------------------------------------------
# SECURITY (CSRF settings)
#--------------------------------------------------------------------

security.tokenName = 'csrf_token_name'
security.headerName = 'X-CSRF-TOKEN'
security.cookieName = 'csrf_cookie_name'
security.expires = 7200
security.regenerate = true
security.redirect = true
security.samesite = 'Lax'

#--------------------------------------------------------------------
# TIMEZONE
#--------------------------------------------------------------------

app.timezone = 'Asia/Makassar'

#--------------------------------------------------------------------
# TELEGRAM BOT (Notifikasi Pesanan Baru ke Admin)
# Token dari @BotFather, chat ID dari @userinfobot.
#--------------------------------------------------------------------

TELEGRAM_BOT_TOKEN="ISI_TOKEN_DARI_BOTFATHER"
TELEGRAM_CHAT_ID="ISI_PRIMARY_ADMIN_CHAT_ID"
# Comma-separated list of admin chat IDs (semua admin terima notifikasi).
TELEGRAM_ADMIN_IDS="chat_id_admin_1,chat_id_admin_2"
# Map chat ID -> user ID admin di tabel users (untuk tombol Verifikasi/Tolak).
# Format: chatId:userId,chatId2:userId2
TELEGRAM_ADMIN_USER_MAP="chat_id_1:1,chat_id_2:1"

#--------------------------------------------------------------------
# EMAIL (Gmail SMTP) — notifikasi ke pelanggan.
# PENTING: Gmail TIDAK menerima password biasa untuk SMTP sejak 2022.
# Wajib pakai "App Password" 16 digit:
#   1. Aktifkan 2-Step Verification di https://myaccount.google.com/security
#   2. Buka https://myaccount.google.com/apppasswords
#   3. Buat App Password baru, salin 16 digit-nya (tanpa spasi)
#   4. Tempel ke email.SMTPPass di bawah
#
# Kalau ketiga field email.SMTPUser/SMTPPass/fromEmail dikosongkan,
# pengiriman email otomatis di-skip (aman buat development).
#--------------------------------------------------------------------

email.protocol   = smtp
email.SMTPHost   = smtp.gmail.com
email.SMTPPort   = 587
email.SMTPCrypto = tls
email.SMTPUser   = your_gmail@gmail.com
email.SMTPPass   = "GANTI_DENGAN_APP_PASSWORD_16_DIGIT"
email.fromEmail  = your_gmail@gmail.com
email.fromName   = "DIX Game Farm"
email.mailType   = html

#--------------------------------------------------------------------
# WHATSAPP (Tombol bantuan ke admin di order detail customer)
#--------------------------------------------------------------------
# Format internasional tanpa '+' dan tanpa spasi.
# Contoh: untuk +62 858-4793-7050 isi "6285847937050".
WHATSAPP_ADMIN_NUMBER = "6285847937050"
