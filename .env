#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'http://localhost:8080/'
app.indexPage = ''
app.forceGlobalSecureRequests = false
app.CSPEnabled = false

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

database.default.hostname = localhost
database.default.database = dixgamefarm_db
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

#--------------------------------------------------------------------
# SECURITY
#--------------------------------------------------------------------

security.tokenName = 'csrf_token_name'
security.headerName = 'X-CSRF-TOKEN'
security.cookieName = 'csrf_cookie_name'
security.expires = 7200
security.regenerate = true
security.redirect = true
security.samesite = 'Lax'

# SESSION - configured in App.php, not here
# session.savePath uses WRITEPATH constant which can't be in .env

#--------------------------------------------------------------------
# TIMEZONE
#--------------------------------------------------------------------

app.timezone = 'Asia/Makassar'

#--------------------------------------------------------------------
# TELEGRAM BOT (Notifikasi Pesanan Baru ke Admin)
#--------------------------------------------------------------------

TELEGRAM_BOT_TOKEN="8723096607:AAFpq3LA9J5aMTmWROpnEF41fIyeIoQMIFg"
TELEGRAM_CHAT_ID="1553203064,8779270308"
# Additional admin chat IDs (comma-separated). All listed IDs receive notifications.
TELEGRAM_ADMIN_IDS="1553203064,8779270308"
# Map Telegram chat ID → sistem user ID admin (diperlukan untuk aksi Verifikasi/Tolak via inline button).
# Format: chatId:userId,chatId2:userId2
# Contoh: jika chat ID 1553203064 adalah admin dengan user ID 1 di tabel users:
# TELEGRAM_ADMIN_USER_MAP="1553203064:1,8779270308:1"
TELEGRAM_ADMIN_USER_MAP="1553203064:1,8779270308:1"

#--------------------------------------------------------------------
# EMAIL (Gmail SMTP)
#--------------------------------------------------------------------
# PENTING: Gmail TIDAK menerima password akun biasa untuk SMTP.
# Anda WAJIB membuat "App Password" (16 digit) di akun Google:
#   1. Aktifkan 2-Step Verification di https://myaccount.google.com/security
#   2. Buka https://myaccount.google.com/apppasswords
#   3. Buat App Password baru, salin 16 digitnya (tanpa spasi)
#   4. Tempel ke email.SMTPPass di bawah ini
#
# JANGAN commit App Password asli ke repository publik.
# File .env ini ikut ter-track git, jadi isi password hanya di mesin lokal.

email.protocol   = smtp
email.SMTPHost   = smtp.gmail.com
email.SMTPPort   = 587
email.SMTPCrypto = tls
email.SMTPUser   = dixgamefarm@gmail.com
email.SMTPPass   = "GANTI_DENGAN_APP_PASSWORD_16_DIGIT"
email.fromEmail  = dixgamefarm@gmail.com
email.fromName   = "DIX Game Farm"
email.mailType   = html

#--------------------------------------------------------------------
# WHATSAPP (Tombol bantuan ke admin di order detail customer)
#--------------------------------------------------------------------
# Nomor WA admin dalam format internasional tanpa '+' dan tanpa spasi.
# Contoh: untuk +62 858-4793-7050 isi "6285847937050".
WHATSAPP_ADMIN_NUMBER = "6285847937050"
